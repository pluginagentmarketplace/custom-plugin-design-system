{
  "hooks": [
    {
      "id": "progress-tracker",
      "name": "Progress Tracking",
      "description": "Automatically tracks learning progress and updates user dashboard",
      "event": "command-executed",
      "condition": "command in ['learn', 'assess', 'projects']",
      "action": "track_progress",
      "enabled": true
    },
    {
      "id": "assessment-analyzer",
      "name": "Assessment Analysis",
      "description": "Analyzes assessment results and provides recommendations",
      "event": "assess-completed",
      "condition": "assessment_score != null",
      "action": "analyze_and_recommend",
      "enabled": true
    },
    {
      "id": "project-validator",
      "name": "Project Completion Validator",
      "description": "Validates project completion and awards achievements",
      "event": "project-submitted",
      "condition": "all_requirements_met",
      "action": "validate_and_award",
      "enabled": true
    },
    {
      "id": "learning-path-updater",
      "name": "Learning Path Updater",
      "description": "Updates recommended learning paths based on progress",
      "event": "milestone-reached",
      "condition": "progress > 25% OR progress > 50% OR progress > 75%",
      "action": "update_learning_path",
      "interval": "weekly",
      "enabled": true
    },
    {
      "id": "resource-recommender",
      "name": "Smart Resource Recommender",
      "description": "Recommends learning resources based on weak areas",
      "event": "assessment-gap-detected",
      "condition": "skill_gap > 30%",
      "action": "recommend_resources",
      "enabled": true
    },
    {
      "id": "achievement-notifier",
      "name": "Achievement Notifier",
      "description": "Notifies user when achievements are unlocked",
      "event": "achievement-unlocked",
      "action": "notify_user",
      "enabled": true
    },
    {
      "id": "consistency-reminder",
      "name": "Learning Consistency Reminder",
      "description": "Reminds users to maintain learning consistency",
      "event": "scheduled",
      "interval": "daily",
      "condition": "days_since_last_activity >= 2",
      "action": "send_reminder",
      "enabled": false
    },
    {
      "id": "certificate-monitor",
      "name": "Certificate Milestone Monitor",
      "description": "Tracks progress towards certificate completion",
      "event": "progress-updated",
      "condition": "certificate_progress >= 80%",
      "action": "notify_certificate_ready",
      "enabled": true
    },
    {
      "id": "agent-load-balancer",
      "name": "Intelligent Agent Load Balancer",
      "description": "Distributes queries across agents based on expertise and load",
      "event": "query-submitted",
      "action": "route_to_best_agent",
      "enabled": true
    },
    {
      "id": "skill-level-detector",
      "name": "Dynamic Skill Level Detector",
      "description": "Automatically detects and adjusts to user's skill level",
      "event": "interaction-logged",
      "action": "adjust_difficulty",
      "enabled": true
    }
  ],
  "notifications": {
    "enabled": true,
    "channels": [
      "in-app",
      "console-message"
    ],
    "frequency": "adaptive",
    "quiet_hours": {
      "enabled": false,
      "start": "22:00",
      "end": "08:00"
    }
  },
  "tracking": {
    "enabled": true,
    "metrics": [
      "learning-hours",
      "projects-completed",
      "assessments-taken",
      "skills-mastered",
      "achievement-unlocked"
    ],
    "storage": "local"
  },
  "automation": {
    "enabled": true,
    "features": [
      "auto-save-progress",
      "auto-update-recommendations",
      "auto-detect-prerequisites",
      "auto-suggest-next-steps"
    ]
  }
}
